<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/legacy_surface">

    <!-- Fluid background -->
    <View
        android:id="@+id/fluid_blob_1"
        android:layout_width="@dimen/legacy_blob_primary_size"
        android:layout_height="@dimen/legacy_blob_primary_size"
        android:layout_gravity="top|start"
        android:layout_marginStart="-140dp"
        android:layout_marginTop="-140dp"
        android:background="@drawable/bg_blob_primary" />

    <View
        android:id="@+id/fluid_blob_2"
        android:layout_width="@dimen/legacy_blob_secondary_size"
        android:layout_height="@dimen/legacy_blob_secondary_size"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-160dp"
        android:layout_marginBottom="-160dp"
        android:background="@drawable/bg_blob_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:id="@+id/hero_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/logo_circle"
                android:layout_width="@dimen/legacy_logo_circle_size"
                android:layout_height="@dimen/legacy_logo_circle_size"
                android:layout_marginBottom="28dp"
                android:background="@drawable/bg_logo_circle">

                <ImageView
                    android:layout_width="@dimen/legacy_logo_size"
                    android:layout_height="@dimen/legacy_logo_size"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_android_robot" />
            </FrameLayout>

            <TextView
                android:id="@+id/welcome_brand_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/legacydroid_brand_name"
                android:textColor="@color/legacy_on_surface"
                android:textSize="@dimen/legacy_brand_title_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/welcome_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/legacydroid_welcome_subtitle"
                android:textColor="@color/legacy_on_surface_variant"
                android:textSize="@dimen/legacy_subtitle_size" />
        </LinearLayout>

        <Button
            android:id="@+id/start"
            style="@style/LegacyButton.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/get_started" />

        <Button
            android:id="@+id/launch_accessibility"
            style="@style/LegacyButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:drawableStart="@drawable/ic_eye"
            android:drawablePadding="8dp"
            android:text="@string/accessibility_settings" />

        <Button
            android:id="@+id/emerg_dialer"
            style="@style/LegacyButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:drawableStart="@drawable/ic_dialer"
            android:drawablePadding="8dp"
            android:text="@string/emergency_call" />

    </LinearLayout>
</FrameLayout>